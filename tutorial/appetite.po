# 必要なライブラリ
# pip install librosa music21 numpy

import librosa
from music21 import stream, note, metadata
import numpy as np

# ボーカル音源ファイル
audio_path = "trim.4EA5D55D-743B-403B-A932-C752EAADA4E0_ボーカル1_mixed.mp3"

# 音声読み込み
y, sr = librosa.load(audio_path)

# ピッチとvoicedフラグの抽出
f0, voiced_flag, voiced_probs = librosa.pyin(
    y,
    fmin=librosa.note_to_hz('G3'),  # バイオリン下限
    fmax=librosa.note_to_hz('E7')
)

# 音声のフレームごとの時間（秒）
times = librosa.times_like(f0, sr=sr)

# Hz → music21音符
def hz_to_note_name(hz):
    if np.isnan(hz):
        return None
    import librosa
    return librosa.hz_to_note(hz, octave=True)

# ド・レ・ミ変換
conversion = {'C':'ド','D':'レ','E':'ミ','F':'ファ','G':'ソ','A':'ラ','B':'シ'}

# music21ストリーム作成
s = stream.Stream()
s.append(metadata.Metadata())
s.metadata.title = "ボーカル譜面"
s.metadata.composer = "自動生成"

prev_note = None
prev_time = None

doremi_list = []

for h, t in zip(f0, times):
    n_name = hz_to_note_name(h)
    if n_name is None:
        prev_note = None
        prev_time = t
        continue
    n = note.Note(n_name)
    if prev_time is None:
        n.quarterLength = 1  # 初回は1拍固定
    else:
        duration = t - prev_time
        n.quarterLength = max(0.25, round(duration*4)/4)  # 1拍=1秒換算は目安
    s.append(n)
    prev_note = n
    prev_time = t
    # ドレミ表記
    note_base = n.name[0]
    octave = n.octave
    doremi_list.append(conversion[note_base] + str(octave) + ("–"*(int(n.quarterLength)-1)))

# 五線譜（musicxml）として保存
s.write('musicxml', fp='vocal_violin_score.xml')

# ドレミテキスト出力
with open("vocal_violin_doremi.txt","w",encoding="utf-8") as f:
    f.write(" ".join(doremi_list))

print("✅ 五線譜（vocal_violin_score.xml）とドレミ譜（vocal_violin_doremi.txt）を出力しました！")
